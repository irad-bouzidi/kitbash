# --- Gradle ---
.gradle/
build/
!**/gradle/wrapper/gradle-wrapper.jar
!src/**/build/
gradle-app.setting
.gradletasknamecache
buildSrc/.gradle/
buildSrc/build/

# --- Java / JVM ---
*.class
*.jar
!**/gradle/wrapper/*.jar
*.war
*.ear
*.nar
out/
bin/
hs_err_pid*
replay_pid*

# --- Node / frontend ---
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# --- Environment & secrets ---
.env
.env.*
!.env.example

# --- Verification output ---
# Logs and the status page are artifacts of a matrix run, not source. A checked-in
# status page is one somebody forgets to regenerate, and then it lies.
verification/build/

# --- Test & coverage output ---
coverage/
.nyc_output/
*.lcov

# --- Logs & runtime ---
*.log
logs/
*.pid

# --- Editors ---
# .idea/ is tracked; its volatile files are ignored by .idea/.gitignore
*.iws
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo

# --- OS ---
.DS_Store
Thumbs.db

# --- create-stack (kitbash-44) ---
clients/*/dist/
clients/*/tsconfig.tsbuildinfo
