spring:
  application:
    name: {{ projectName }}
  threads:
    virtual:
      enabled: true

{{ projectName }}:
  environment-name: {{ '${' }}{{ envPrefix }}_ENVIRONMENT_NAME}
  max-{{ entityTable }}-per-page: 50

logging:
  structured:
    format:
      console: ecs

management:
  endpoints:
    web:
      exposure:
        include: health,info,metrics
  endpoint:
    health:
      probes:
        enabled: true
      show-details: when-authorized
  info:
    env:
      enabled: true

info:
  app:
    name: {{ projectName }}
    environment: {{ '${' }}{{ envPrefix }}_ENVIRONMENT_NAME}

springdoc:
  swagger-ui:
    path: /swagger-ui.html
