spring:
  application:
    name: {{ projectName }}
  threads:
    virtual:
      enabled: true

{{ projectName }}:
  environment-name: {{ '${' }}{{ envPrefix }}_ENVIRONMENT_NAME}
  max-{{ entityTable }}-per-page: 50

logging:
  structured:
    format:
      console: ecs

management:
  endpoints:
    web:
      exposure:
        # A list rather than the comma-separated string Spring also accepts, so a feature recipe
        # can add an endpoint by merging one entry. mergeYaml unions lists and refuses to overwrite
        # a scalar another recipe set — which is the right rule, and the reason for the shape.
        include:
          - health
          - info
          - metrics
  endpoint:
    health:
      probes:
        enabled: true
      show-details: when-authorized
  info:
    env:
      enabled: true

info:
  app:
    name: {{ projectName }}
    environment: {{ '${' }}{{ envPrefix }}_ENVIRONMENT_NAME}

springdoc:
  swagger-ui:
    path: /swagger-ui.html
