package {{ packageName }}.domain

import jakarta.persistence.Column
import jakarta.persistence.Entity
import jakarta.persistence.GeneratedValue
import jakarta.persistence.GenerationType
import jakarta.persistence.Id
import jakarta.persistence.Table
import java.time.Instant

/**
 * The example entity. One aggregate is enough to show the shape of a slice: an empty skeleton
 * teaches nothing, and a second entity would only repeat what this one already shows.
 *
 * A class rather than a `data class`: a data class derives `equals` from every property, and an
 * entity's identity is its database id. The two disagree the moment a {{ entityName | camel }} is saved.
 */
@Entity
@Table(name = "{{ entityTable }}")
class {{ entityName }} private constructor(
    @Column(nullable = false)
    var name: String,
    @Column(name = "quantity", nullable = false)
    var quantity: Int,
    @Column(name = "created_at", nullable = false, updatable = false)
    val createdAt: Instant,
) {
    // `protected set` rather than `private set`: `allOpen` makes every entity open so
    // Hibernate can proxy it, and Kotlin forbids a private setter on an open property.
    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    var id: Long? = null
        protected set

    fun rename(newName: String) {
        name = newName
    }

    fun restock(amount: Int) {
        require(amount >= 0) { "restock amount must not be negative: $amount" }
        quantity += amount
    }

    override fun equals(other: Any?): Boolean {
        if (this === other) {
            return true
        }
        // Identity is the database id; two unsaved {{ entityTable }} are never equal.
        return other is {{ entityName }} && id != null && id == other.id
    }

    override fun hashCode(): Int = id?.hashCode() ?: 0

    companion object {
        fun of(
            name: String,
            quantity: Int,
        ): {{ entityName }} = {{ entityName }}(name, quantity, Instant.now())
    }
}
