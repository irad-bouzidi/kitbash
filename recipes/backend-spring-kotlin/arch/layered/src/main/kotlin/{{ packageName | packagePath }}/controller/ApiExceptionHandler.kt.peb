package {{ packageName }}.controller

import {{ packageName }}.config.CorrelationIdFilter
import {{ packageName }}.service.Duplicate{{ entityName }}NameException
import {{ packageName }}.service.{{ entityName }}NotFoundException
import org.slf4j.MDC
import org.springframework.http.HttpStatus
import org.springframework.http.ProblemDetail
import org.springframework.web.bind.annotation.ExceptionHandler
import org.springframework.web.bind.annotation.RestControllerAdvice

/**
 * Errors are RFC 9457 problem documents, and each one carries the request's correlation id so a
 * user can paste the response into a ticket and the log line is one search away.
 */
@RestControllerAdvice
class ApiExceptionHandler {
    @ExceptionHandler({{ entityName }}NotFoundException::class)
    fun notFound(exception: {{ entityName }}NotFoundException): ProblemDetail = problem(HttpStatus.NOT_FOUND, "{{ entityName }} not found", exception.message)

    @ExceptionHandler(Duplicate{{ entityName }}NameException::class)
    fun duplicate(exception: Duplicate{{ entityName }}NameException): ProblemDetail =
        problem(HttpStatus.CONFLICT, "Duplicate {{ entityName | camel }} name", exception.message)

    private fun problem(
        status: HttpStatus,
        title: String,
        detail: String?,
    ): ProblemDetail {
        val problem = ProblemDetail.forStatusAndDetail(status, detail)
        problem.title = title
        MDC.get(CorrelationIdFilter.MDC_KEY)?.let { problem.setProperty("correlationId", it) }
        return problem
    }
}
