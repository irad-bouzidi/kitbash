package {{ packageName }}.adapter.outbound.persistence

import jakarta.persistence.Column
import jakarta.persistence.Entity
import jakarta.persistence.GeneratedValue
import jakarta.persistence.GenerationType
import jakarta.persistence.Id
import jakarta.persistence.Table
import java.time.Instant

/**
 * The database row, and nothing else.
 *
 * Named `Row` rather than `Entity` on purpose: in a hexagonal project the word "entity" already
 * belongs to `domain.{{ entityName }}`, and two classes competing for it is how the mapping quietly stops
 * happening and JPA annotations appear on the domain a release later.
 */
@Entity
@Table(name = "{{ entityTable }}")
internal class {{ entityName }}Row(
    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    var id: Long?,
    @Column(nullable = false)
    var name: String,
    @Column(name = "quantity", nullable = false)
    var quantity: Int,
    @Column(name = "created_at", nullable = false, updatable = false)
    var createdAt: Instant,
)
