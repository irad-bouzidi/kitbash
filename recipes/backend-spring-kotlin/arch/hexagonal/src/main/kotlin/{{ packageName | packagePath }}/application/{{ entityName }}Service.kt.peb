/**
 * The use cases. Business rules live here and in the domain, never in an adapter.
 *
 * This class is annotated — `@Service`, `@Transactional` — and that is deliberate rather than a
 * leak. A transaction boundary is a statement about a use case, so it belongs on the use case.
 * What must stay clean is the *domain*, and `ArchitectureTest` enforces exactly that line rather
 * than a slogan about framework-free code.
 */
@Service
@Transactional(readOnly = true)
class {{ entityName }}Service(
    private val {{ entityTable }}: {{ entityName }}Repository,
) : Manage{{ entityName }}s {
    override fun findAll(): List<{{ entityName }}> = {{ entityTable }}.findAll()

    override fun findById(id: Long): {{ entityName }} = {{ entityTable }}.findById(id) ?: throw {{ entityName }}NotFoundException(id)

    @Transactional
    override fun create(
        name: String,
        quantity: Int,
    ): {{ entityName }} {
        if ({{ entityTable }}.existsByName(name)) {
            throw Duplicate{{ entityName }}NameException(name)
        }
        return {{ entityTable }}.save({{ entityName }}.of(name, quantity))
    }

    @Transactional
    override fun restock(
        id: Long,
        amount: Int,
    ): {{ entityName }} {
        val {{ entityName | camel }} = findById(id)
        {{ entityName | camel }}.restock(amount)
        // Explicit, unlike the layered version: a domain object is not a managed entity here, so
        // nothing writes it back for us at commit. That is the trade hexagonal makes.
        return {{ entityTable }}.save({{ entityName | camel }})
    }

    @Transactional
    override fun delete(id: Long) {
        if (!{{ entityTable }}.existsById(id)) {
            throw {{ entityName }}NotFoundException(id)
        }
        {{ entityTable }}.deleteById(id)
    }
}
