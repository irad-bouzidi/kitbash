import {{ packageName }}.application.port.outbound.{{ entityName }}Repository
import {{ packageName }}.domain.Duplicate{{ entityName }}NameException
import {{ packageName }}.domain.{{ entityName }}
import {{ packageName }}.domain.{{ entityName }}NotFoundException
import org.springframework.stereotype.Service
