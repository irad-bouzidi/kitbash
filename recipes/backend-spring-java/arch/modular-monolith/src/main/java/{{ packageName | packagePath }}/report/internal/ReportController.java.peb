package {{ packageName }}.report.internal;

import {{ packageName }}.{{ entityName | camel }}.{{ entityName }}Api;
import io.swagger.v3.oas.annotations.Operation;
import io.swagger.v3.oas.annotations.tags.Tag;
import java.util.List;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

/**
 * The second module, and the reason the first one's boundary means anything.
 *
 * <p>A single-module "modular monolith" is a claim no test can check. This module exists to be a
 * consumer: it reads the {{ entityName | camel }} module through {@link {{ entityName }}Api} and cannot see
 * {@code {{ entityName | camel }}.internal} at all — not by convention, but because `ArchitectureTest` fails the
 * build if it tries and because those classes are package-private besides.
 *
 * <p>It owns no tables. A module that needs another module's data asks for it; going to the
 * database directly is how a modular monolith becomes a distributed one with a shared schema.
 */
@RestController
@RequestMapping("/api/report")
@Tag(name = "Report", description = "A second module, reading the first one through its published API")
class ReportController {

    private final {{ entityName }}Api {{ entityTable }};

    ReportController({{ entityName }}Api {{ entityTable }}) {
        this.{{ entityTable }} = {{ entityTable }};
    }

    @GetMapping
    @Operation(summary = "Totals across every {{ entityName | camel }}")
    StockReport stock() {
        List<Integer> quantities =
                {{ entityTable }}.summaries().stream().map(summary -> summary.quantity()).toList();
        return new StockReport(
                quantities.size(),
                quantities.stream().mapToInt(Integer::intValue).sum());
    }
}
