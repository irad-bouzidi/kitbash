package {{ packageName }}.{{ entityName | camel }}.internal;

import {{ packageName }}.config.CorrelationIdFilter;
import org.slf4j.MDC;
import org.springframework.http.HttpStatus;
import org.springframework.http.ProblemDetail;
import org.springframework.web.bind.annotation.ExceptionHandler;
import org.springframework.web.bind.annotation.RestControllerAdvice;

/**
 * Errors are RFC 9457 problem documents, and each one carries the request's correlation id so a
 * user can paste the response into a ticket and the log line is one search away.
 *
 * <p>Scoped to this module's controllers rather than global: the failures it knows how to render
 * are this module's own, and a shared advice class is how two modules end up having to agree on
 * an exception hierarchy they do not share.
 */
@RestControllerAdvice(assignableTypes = {{ entityName }}Controller.class)
class {{ entityName }}ExceptionHandler {

    @ExceptionHandler({{ entityName }}NotFoundException.class)
    ProblemDetail notFound({{ entityName }}NotFoundException exception) {
        return problem(HttpStatus.NOT_FOUND, "{{ entityName }} not found", exception.getMessage());
    }

    @ExceptionHandler(Duplicate{{ entityName }}NameException.class)
    ProblemDetail duplicate(Duplicate{{ entityName }}NameException exception) {
        return problem(HttpStatus.CONFLICT, "Duplicate {{ entityName | camel }} name", exception.getMessage());
    }

    private ProblemDetail problem(HttpStatus status, String title, String detail) {
        ProblemDetail problem = ProblemDetail.forStatusAndDetail(status, detail);
        problem.setTitle(title);
        String correlationId = MDC.get(CorrelationIdFilter.MDC_KEY);
        if (correlationId != null) {
            problem.setProperty("correlationId", correlationId);
        }
        return problem;
    }
}
