package {{ packageName }};

import static com.tngtech.archunit.lang.syntax.ArchRuleDefinition.noClasses;

import com.tngtech.archunit.core.domain.JavaClasses;
import com.tngtech.archunit.core.importer.ImportOption;
import com.tngtech.archunit.junit.AnalyzeClasses;
import com.tngtech.archunit.junit.ArchTest;
import com.tngtech.archunit.library.dependencies.SlicesRuleDefinition;

/**
 * The architecture, as a test your build runs.
 *
 * <p>A modular monolith differs from a monolith with folders in exactly one respect: the folders
 * are enforced. Java's package-private access does most of the work here — every class in a
 * module's {@code internal} package that can be package-private is — but access modifiers cannot
 * express "this package is private to its parent", and a public class added in a hurry silently
 * removes the boundary. These rules are what notices.
 *
 * <p>Each rule is a <em>method</em> rather than the {@code static final ArchRule} field ArchUnit's
 * own examples use, and that is not style. Maven Surefire filters discovered tests by their
 * source, keeps {@code MethodSource} and drops {@code FieldSource} — so the field form reports
 * "Tests run: 0" and passes, silently, on a Maven build. Gradle runs both. Since this project can
 * be generated with either build tool, only the form that works under both is safe to ship.
 *
 * <p>Adding a module means adding one method below. That is the intended cost: a module nobody
 * declared is a module nobody is enforcing.
 */
@AnalyzeClasses(packages = "{{ packageName }}", importOptions = ImportOption.DoNotIncludeTests.class)
class ArchitectureTest {

    @ArchTest
    static void {{ entityName | camel }}InternalsAreItsOwn(JavaClasses classes) {
        internalsOf("{{ entityName | camel }}").check(classes);
    }

    @ArchTest
    static void reportInternalsAreItsOwn(JavaClasses classes) {
        internalsOf("report").check(classes);
    }

    /**
     * The one rule that makes the modules worth having. Everything else is layout.
     *
     * <p>It reads "nothing outside the module", which includes the module's own public API class:
     * that class may be implemented from inside, and may not be reached into from outside.
     */
    private static com.tngtech.archunit.lang.ArchRule internalsOf(String module) {
        return noClasses()
                .that()
                .resideOutsideOfPackage("..%s..".formatted(module))
                .should()
                .dependOnClassesThat()
                .resideInAPackage("..%s.internal..".formatted(module))
                .because("`%s.internal` is private to the %s module. Another module talks to it "
                                .formatted(module, module)
                        + "through the public API class in `%s`, and if what you need is not there, ".formatted(module)
                        + "adding it is a deliberate widening of that module's contract.");
    }

    /**
     * Cycles are what turn a set of modules back into one module.
     *
     * <p>Today {@code report} reads {@code {{ entityName | camel }}} and nothing reads {@code report}. The first time
     * somebody makes that mutual, this fails — which is much cheaper than discovering it when the
     * modules are meant to become separate deployables.
     */
    @ArchTest
    static void modulesAreFreeOfCycles(JavaClasses classes) {
        SlicesRuleDefinition.slices()
                .matching("{{ packageName }}.(*)..")
                .should()
                .beFreeOfCycles()
                .because("two modules that need each other are one module that has not admitted it.")
                .check(classes);
    }

    /**
     * A module owns its tables. Reading another module's rows directly is the shortcut that makes
     * the published API decorative.
     */
    @ArchTest
    static void onlyModulesTouchPersistence(JavaClasses classes) {
        noClasses()
                .that()
                .resideOutsideOfPackage("..internal..")
                .should()
                .dependOnClassesThat()
                .resideInAnyPackage("jakarta.persistence..", "org.springframework.data..")
                .because("persistence belongs inside a module. A repository reachable from outside one "
                        + "is a shared database dressed as a shared class.")
                .check(classes);
    }
}
