/*
 * The only file that knows the shape of the API.
 *
 * Deliberately isolated: when the typed-client option is on, `kitbash-33` replaces exactly
 * this file with a client generated from the backend's OpenAPI document, and nothing else in
 * the application has to change. A fetch call scattered through three components is what makes
 * that swap impossible.
 */

// kitbash:imports

/** Same-origin by default, because the dev server and the container both proxy `/api`. */
const BASE_URL = import.meta.env.VITE_API_BASE_URL ?? '';

export interface {{ entityName }} {
  id: number;
  name: string;
  quantity: number;
  createdAt: string;
}

export interface Create{{ entityName }}Request {
  name: string;
  quantity: number;
}

/** An RFC 9457 problem document, which is what the backend returns for every failure. */
interface ProblemDetail {
  title?: string;
  detail?: string;
}

export class ApiError extends Error {
  readonly status: number;

  constructor(message: string, status: number) {
    super(message);
    this.name = 'ApiError';
    this.status = status;
  }
}

/**
 * Headers every request carries beyond the obvious one.
 *
 * Empty until a recipe adds to it, and shaped exactly like the typed client's so that one patch
 * line serves both: a marker at a different indentation in the two variants is a marker that
 * inserts badly formatted code into one of them, which is how §35 found this.
 */
function extraHeaders(): Record<string, string> {
  return {
    // kitbash:headers
  };
}

async function request<T>(path: string, init?: RequestInit): Promise<T> {
  const response = await fetch(`${BASE_URL}/api${path}`, {
    ...init,
    headers: {
      'Content-Type': 'application/json',
      ...extraHeaders(),
      ...init?.headers,
    },
  });

  if (!response.ok) {
    // The server's own words, not a generic message: it already explains what went wrong
    // and carries the correlation id needed to find the log line.
    const problem = (await response.json().catch(() => ({}))) as ProblemDetail;
    throw new ApiError(problem.detail ?? problem.title ?? response.statusText, response.status);
  }

  return response.status === 204 ? (undefined as T) : ((await response.json()) as T);
}

export function list{{ entityName }}s(): Promise<{{ entityName }}[]> {
  return request<{{ entityName }}[]>('/{{ entityTable }}');
}

export function create{{ entityName }}({{ entityName | camel }}: Create{{ entityName }}Request): Promise<{{ entityName }}> {
  return request<{{ entityName }}>('/{{ entityTable }}', { method: 'POST', body: JSON.stringify({{ entityName | camel }}) });
}

export function delete{{ entityName }}(id: number): Promise<void> {
  return request<void>(`/{{ entityTable }}/${id}`, { method: 'DELETE' });
}
