package {{ packageName }};

import static org.assertj.core.api.Assertions.assertThat;

import com.fasterxml.jackson.databind.ObjectMapper;
import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Path;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.condition.EnabledIfSystemProperty;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.boot.test.web.client.TestRestTemplate;
import org.springframework.test.context.ActiveProfiles;

/**
 * Writes {@code frontend/openapi.json}, which the TypeScript client is generated from.
 *
 * <p>A test rather than a build task, and normally skipped, which both want explaining.
 *
 * <p>springdoc builds the document by inspecting a <em>running</em> application: the controllers,
 * their annotations and the beans they were wired with. Nothing can produce it from compiled
 * classes alone, so something has to start the context — and the only thing in this project that
 * already knows how to start it with a database is the test suite. Reusing that is cheaper than a
 * second mechanism that would need its own Postgres.
 *
 * <p>It extends the database's test base for the same reason: the application will not start
 * without one, and the {@code database} capability's contract is that a class by that name exists
 * (see docs/recipe-format.md).
 *
 * <p>It is skipped unless {@code -Dkitbash.openapi.write=true} because writing a file into the
 * working tree is not something an ordinary {@code test} run should do. {@code ./gradlew
 * generateApiClient} passes the flag; nothing else does.
 */
@SpringBootTest(webEnvironment = SpringBootTest.WebEnvironment.RANDOM_PORT)
@ActiveProfiles("test")
@EnabledIfSystemProperty(
        named = "kitbash.openapi.write",
        matches = "true",
        disabledReason = "Run ./gradlew generateApiClient to refresh frontend/openapi.json")
class OpenApiDocumentTest extends PostgresTestBase {

    private static final Path DOCUMENT = Path.of("frontend", "openapi.json");

    @Autowired
    private TestRestTemplate http;

    @Test
    @DisplayName("the served document is written where the client generator reads it")
    void writesTheDocument() throws IOException {
        String served = http.getForObject("/v3/api-docs", String.class);

        assertThat(served).as("springdoc served nothing at /v3/api-docs").isNotBlank();

        // Pretty-printed with sorted keys: the file is committed nowhere but is diffed by people
        // during an upgrade, and springdoc's map ordering is not stable between runs.
        ObjectMapper json = new ObjectMapper();
        json.configure(com.fasterxml.jackson.databind.SerializationFeature.ORDER_MAP_ENTRIES_BY_KEYS, true);
        String pretty = json.writerWithDefaultPrettyPrinter().writeValueAsString(json.readTree(served));

        Files.createDirectories(DOCUMENT.getParent());
        Files.writeString(DOCUMENT, pretty + "\n");
    }
}
