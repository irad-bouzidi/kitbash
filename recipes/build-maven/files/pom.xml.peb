<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <!-- kitbash:parent -->

  <groupId>{{ groupId }}</groupId>
  <artifactId>{{ projectName }}</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>{{ projectName }}</name>

  <properties>
    <java.version>{{ javaVersion }}</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spotless.version>2.46.1</spotless.version>
    <palantir-java-format.version>2.57.0</palantir-java-format.version>
    <!-- kitbash:versions -->
  </properties>

  <dependencies>
    <!-- kitbash:dependencies -->
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <compilerArgs>
            <!-- Parameter names survive compilation, which is what lets Spring bind them. -->
            <arg>-parameters</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <!--
        Bound to `validate` so `mvn verify` fails on badly formatted code rather than only on
        failing tests — the same rule the Gradle build enforces by making `check` depend on
        `spotlessCheck`.
      -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <lineEndings>UNIX</lineEndings>
          <java>
            <includes>
              <include>src/**/*.java</include>
            </includes>
            <palantirJavaFormat>
              <version>${palantir-java-format.version}</version>
            </palantirJavaFormat>
            <removeUnusedImports/>
            <trimTrailingWhitespace/>
            <endWithNewline/>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>validate</phase>
          </execution>
        </executions>
      </plugin>
      <!-- kitbash:plugins -->
    </plugins>
  </build>
</project>
