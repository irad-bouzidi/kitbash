<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <!-- kitbash:parent -->

  <groupId>{{ groupId }}</groupId>
  <artifactId>{{ projectName }}</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>{{ projectName }}</name>

  <properties>
    <java.version>{{ javaVersion }}</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spotless.version>2.46.1</spotless.version>
    <!-- kitbash:versions -->
  </properties>

  <dependencies>
    <!-- kitbash:dependencies -->
  </dependencies>

  <build>
    <!-- kitbash:build -->
    <plugins>
      <!--
        Bound to `validate` so `mvn verify` fails on badly formatted code rather than only on
        failing tests — the same rule the Gradle build enforces by making `check` depend on
        `spotlessCheck`. Which language it formats is not this recipe's business: the recipe
        that brings the sources contributes its own block at the marker below.
      -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <lineEndings>UNIX</lineEndings>
          <!-- kitbash:formats -->
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>validate</phase>
          </execution>
        </executions>
      </plugin>
      <!-- kitbash:plugins -->
    </plugins>
  </build>

  <!--
    Profiles a feature recipe adds. Empty unless something needs one: §33's client generator is
    the first, and it wants a lifecycle you opt into rather than one that runs on every build.
  -->
  <profiles>
    <!-- kitbash:profiles -->
  </profiles>
</project>
