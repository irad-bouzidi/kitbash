create table {{ entityTable }} (
    id         bigint generated by default as identity primary key,
    name       varchar(120) not null,
    quantity   integer      not null default 0 check (quantity >= 0),
    created_at timestamptz  not null default now()
);

-- The service checks for a duplicate name before inserting; this constraint is what
-- makes that check true under concurrency rather than merely usually true.
create unique index {{ entityTable }}_name_key on {{ entityTable }} (name);
