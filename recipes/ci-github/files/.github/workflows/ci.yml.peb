# Build, test, lint and publish an image. Every step is one command; anything more belongs in
# the build itself, where it can be run locally.
#
# The same pipeline as the GitLab recipe's, job for job, in a syntax that shares nothing with it.
# Two files rather than one templated file rendering both providers: a conditional per line of
# YAML would be soup, and neither file would be one a user could read and edit.
name: CI

on:
  push:
    branches: ["**"]
  pull_request:

# A second push to the same branch cancels the first. A queue of superseded runs is a slow
# pipeline that nobody is waiting for.
concurrency:
  group: {{ '${{' }} github.workflow {{ '}}' }}-{{ '${{' }} github.ref {{ '}}' }}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "{{ javaVersion }}"
{% if capabilities contains 'maven-build' %}          cache: maven

      # Spotless is bound to `validate`, so a formatting failure is a pipeline failure rather
      # than a review comment.
      - run: ./mvnw -B verify

      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: test-results
          path: target/surefire-reports/TEST-*.xml
          if-no-files-found: ignore{% else %}          cache: gradle

      # `check` depends on spotlessCheck, so a formatting failure is a pipeline failure rather
      # than a review comment.
      - run: ./gradlew --no-daemon build

      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: test-results
          path: build/test-results/test/TEST-*.xml
          if-no-files-found: ignore{% endif %}

  # The same multi-stage Dockerfile a developer builds locally, not a second definition that
  # would drift from it.
  image:
    runs-on: ubuntu-latest
    needs: [build]
    if: github.ref == format('refs/heads/{0}', github.event.repository.default_branch)
    permissions:
      contents: read
      packages: write
    steps:
      - uses: actions/checkout@v4

      - uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: {{ '${{' }} github.actor {{ '}}' }}
          password: {{ '${{' }} secrets.GITHUB_TOKEN {{ '}}' }}

      - uses: docker/build-push-action@v6
        with:
          context: .
          push: true
          tags: ghcr.io/{{ '${{' }} github.repository {{ '}}' }}:{{ '${{' }} github.sha {{ '}}' }}
# Jobs other recipes add. The frontend's is the first (§33).
# kitbash:jobs
