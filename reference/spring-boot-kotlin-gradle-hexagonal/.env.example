# Every variable this application reads. Copy to .env and fill in.
# A missing one fails startup with a message naming it, rather than at the
# first request that happens to need it.

# Free-text environment label, reported by /actuator/info and the OpenAPI description.
DEMO_ENVIRONMENT_NAME=local

# JDBC URL of the Postgres database.
DEMO_DB_URL=jdbc:postgresql://localhost:5432/demo

# The database username.
DEMO_DB_USERNAME=demo

# The database password.
DEMO_DB_PASSWORD=demo

# OpenID issuer this service trusts. Its /.well-known/openid-configuration is read at startup, so a wrong value fails the boot rather than the first request.
DEMO_AUTH_ISSUER_URI=https://issuer.example.com/realms/demo

# The audience this service accepts. Without it any token from the issuer opens this service, including one obtained for something else entirely.
DEMO_AUTH_AUDIENCE=demo-api

# OTLP/HTTP endpoint spans are sent to. No collector is generated — §11 keeps the monitoring stack out of this project — so point it at one you run.
DEMO_OTLP_ENDPOINT=http://localhost:4318/v1/traces
