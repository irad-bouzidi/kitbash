{
  "$comment": [
    "The names in this reference project that become generator variables.",
    "kitbash-13 extracts recipes by replacing these literals with placeholders;",
    "kitbash-19 generates with exactly these values and asserts the result equals",
    "this directory. That test is only meaningful if this file stays accurate, so",
    "renaming anything below is a change to this file in the same commit.",
    "This file is reference metadata and is excluded from extraction."
  ],
  "referenceProject": "spring-boot-java-gradle-layered",
  "recipeIds": ["base", "backend-spring-java", "db-postgres-flyway", "infra-docker"],
  "selection": {
    "schemaVersion": 1,
    "projectName": "demo",
    "options": {
      "build-tool": "gradle-kotlin",
      "backend": "spring-boot-java",
      "architecture": "layered",
      "database": "postgres-flyway"
    },
    "variables": {
      "groupId": "com.example",
      "artifactId": "demo",
      "packageName": "com.example.demo",
      "javaVersion": "21",
      "applicationClass": "DemoApplication",
      "entityName": "Widget",
      "entityTable": "widgets",
      "envPrefix": "DEMO"
    }
  },
  "literals": {
    "com.example": "${groupId}",
    "com/example": "${groupId | replace('.', '/')}",
    "com.example.demo": "${packageName}",
    "com/example/demo": "${packageName | replace('.', '/')}",
    "demo": "${artifactId}",
    "DemoApplication": "${applicationClass}",
    "DemoProperties": "${applicationClass | replace('Application', 'Properties')}",
    "Widget": "${entityName}",
    "widget": "${entityName | lower}",
    "widgets": "${entityTable}",
    "DEMO_": "${envPrefix}_"
  },
  "excludeFromExtraction": ["reference-variables.json", ".gradle/", "build/"]
}
